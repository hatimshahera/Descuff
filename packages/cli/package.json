{
  "name": "descuff",
  "version": "0.13.2",
  "description": "Turn local Next.js websites into interfaces AI agents can understand and use.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/hatimshahera/Descuff",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/hatimshahera/Descuff#readme",
  "bugs": {
    "url": "https://github.com/hatimshahera/Descuff/issues"
  },
  "keywords": [
    "agents",
    "ai-agents",
    "llms.txt",
    "nextjs",
    "openapi",
    "schema-org",
    "webmcp"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "descuff": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run test"
  },
  "dependencies": {
    "@descuff/agent-workflow": "^0.13.2",
    "@descuff/analyzer-graphify": "^0.13.2",
    "@descuff/analyzer-nextjs": "^0.13.2",
    "@descuff/core": "^0.13.2",
    "@descuff/ir": "^0.13.2",
    "@descuff/reporter": "^0.13.2",
    "@descuff/standard-api-catalog": "^0.13.2",
    "@descuff/standard-core": "^0.13.2",
    "@descuff/standard-llms-txt": "^0.13.2",
    "@descuff/standard-openapi": "^0.13.2",
    "@descuff/standard-schema-org": "^0.13.2",
    "@descuff/standard-webmcp": "^0.13.2",
    "@descuff/validator": "^0.13.2",
    "@descuff/drift-core": "^0.13.2"
  }
}
