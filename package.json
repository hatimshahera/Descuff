{
  "name": "descuff-workspace",
  "version": "0.1.15",
  "description": "Turn local Next.js websites into interfaces AI agents can understand and use.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hatimshahera/Descuff.git"
  },
  "homepage": "https://github.com/hatimshahera/Descuff#readme",
  "bugs": {
    "url": "https://github.com/hatimshahera/Descuff/issues"
  },
  "keywords": [
    "agents",
    "ai-agents",
    "llms.txt",
    "nextjs",
    "openapi",
    "schema-org",
    "webmcp"
  ],
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.packages.json",
    "clean": "pnpm -r exec rm -rf dist tsconfig.tsbuildinfo",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -b tsconfig.packages.json --pretty false",
    "ci": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm smoke",
    "smoke": "node scripts/smoke-cli.mjs",
    "release:changelog": "node scripts/changelog-check.mjs",
    "release:npm-env": "node scripts/npm-env-check.mjs",
    "release:graph": "node scripts/release-graph.mjs",
    "release:install-smoke": "pnpm build && node scripts/release-install-smoke.mjs",
    "release:publish": "node scripts/release-publish.mjs",
    "release:publish-plan": "node scripts/release-publish.mjs --dry-run",
    "release:recovery-drill": "node scripts/release-recovery.mjs",
    "release:registry": "node scripts/registry-check.mjs",
    "release:check": "pnpm build && node scripts/npm-env-check.mjs && node scripts/changelog-check.mjs && node scripts/release-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^4.0.15"
  }
}
